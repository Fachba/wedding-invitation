(function ($) {
    "use strict";
            const sampul = $('.modalx').data('sampul');
            $('.modalx').css('background-image','url('+sampul+')');
            // $('body').css('overflow','hidden');
            $('.lws-button-wrapper button').on('click',function(){
	            $('.modalx').addClass('removeModals');
	            $('body').css('overflow','auto');
	            document.getElementById("song").play();
            });
}(jQuery));